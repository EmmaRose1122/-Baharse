# ==============================================================================
# BAHARSE FOREIGN IMPORTS - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Supabase API Settings
# (Obtain from your Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Store Settings
NEXT_PUBLIC_SITE_NAME=BaharSe Foreign Imports
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ==============================================================================
# SECURE ADMIN AUTHENTICATION SECRETS (STRICT ACCESS CONTROL)
# ==============================================================================
# Dedicated Admin Email (Only authorized admin email(s) can access /admin)
ADMIN_EMAIL=admin@baharse.pk
ADMIN_PASSWORD=change-this-to-a-strong-password
ADMIN_SECRET_KEY=generate-a-random-64-character-secret-key-here
ADMIN_ALLOWED_EMAILS=admin@baharse.pk

# ==============================================================================
# AI CHAT BOT CONFIGURATION (GEMINI & GROK)
# ==============================================================================
# 1. Google Gemini (FREE tier from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-free-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# 2. xAI Grok (from https://console.x.ai/)
GROK_API_KEY=your-xai-grok-api-key
GROK_MODEL=grok-beta

# Optional provider preference ("gemini" or "grok", defaults to whichever key is filled)
AI_PROVIDER=gemini
